---
import PageFrame from "./PageFrame.astro";

/** @typedef {import("../../data/projects").Project} Project */
/** @typedef {{ lang: "en" | "fr", project: Project }} Props */
/** @type {Props} */
const { lang, project } = Astro.props;
const isFrench = lang === "fr";
const content = isFrench ? project.fr : project.en;
const screenshot = project.screenshot;
const copy = isFrench
  ? {
      label: "Fiche projet",
      context: "Contexte confirmé",
      status: "État actuel",
      contribution: "Réalisation",
      contributionDetail: "Projet réalisé individuellement.",
      overview: "Présentation",
      problem: "Problème traité",
      audience: "Public visé",
      features: "Fonctionnalités opérationnelles",
      contributions: "Contribution personnelle",
      result: "Résultat",
      limitations: "Limites et travaux restants",
      evidenceTitle: "Captures d’interface",
      scopeTitle: "Information à compléter",
      technologies: "Technologies vérifiées",
      repository: "Dépôt public",
      noTechnologies:
        "Aucune stack technique n’est publiée pour ce projet tant qu’elle n’a pas été vérifiée.",
      back: "Retour à l’index des projets",
    }
  : {
      label: "Project case study",
      context: "Confirmed context",
      status: "Current status",
      contribution: "Delivery",
      contributionDetail: "Developed individually.",
      overview: "Overview",
      problem: "Problem addressed",
      audience: "Intended users",
      features: "Working features",
      contributions: "Personal contribution",
      result: "Result",
      limitations: "Known limitations and remaining work",
      evidenceTitle: "Interface screenshots",
      scopeTitle: "Information to complete",
      technologies: "Verified technologies",
      repository: "Public repository",
      noTechnologies:
        "No project stack is published until it has been verified.",
      back: "Back to the project index",
    };
---

<PageFrame
  lang={lang}
  label={copy.label}
  title={project.name}
  introduction={content.status}
>
  <article class="case-study" aria-label={project.name}>
    <p class="case-study__progress">
      <span class="case-study__status-mark" aria-hidden="true"></span>
      {content.status}
    </p>
    {content.summary && (
      <section class="case-study__section">
        <h2>{copy.overview}</h2>
        <p>{content.summary}</p>
      </section>
    )}
    <dl class="case-study__facts">
      <div>
        <dt>{copy.context}</dt>
        <dd>{content.context}</dd>
      </div>
      <div>
        <dt>{copy.status}</dt>
        <dd>{content.progress}</dd>
      </div>
      <div>
        <dt>{copy.contribution}</dt>
        <dd>{copy.contributionDetail}</dd>
      </div>
      {project.technologies.length > 0 && (
        <div>
          <dt>{copy.technologies}</dt>
          <dd>{content.technologyNotes ?? project.technologies.join(" · ")}</dd>
        </div>
      )}
    </dl>
    {content.problem && (
      <section class="case-study__section">
        <h2>{copy.problem}</h2>
        <p>{content.problem}</p>
      </section>
    )}
    {content.audience && (
      <section class="case-study__section">
        <h2>{copy.audience}</h2>
        <p>{content.audience}</p>
      </section>
    )}
    {content.features && (
      <section class="case-study__section">
        <h2>{copy.features}</h2>
        <p>{content.features}</p>
      </section>
    )}
    {content.contributions && (
      <section class="case-study__section">
        <h2>{copy.contributions}</h2>
        <p>{content.contributions}</p>
      </section>
    )}
    {content.result && (
      <section class="case-study__section">
        <h2>{copy.result}</h2>
        <p>{content.result}</p>
      </section>
    )}
    {content.limitations && (
      <section class="case-study__pending">
        <h2>{copy.limitations}</h2>
        <p>{content.limitations}</p>
        <p>{content.openItems}</p>
      </section>
    )}
    {project.technologies.length === 0 && (
      <p class="case-study__no-technology">{copy.noTechnologies}</p>
    )}
    {screenshot && (
      <section
        class="case-study__evidence"
        aria-labelledby="case-study-evidence"
      >
        <h2 id="case-study-evidence">{copy.evidenceTitle}</h2>
        <figure
          class:list={[
            "case-study__figure",
            screenshot.width < 1000 && "case-study__figure--compact",
          ]}
        >
          <img
            src={screenshot.src}
            width={screenshot.width}
            height={screenshot.height}
            alt={screenshot[lang].alt}
            loading="lazy"
            decoding="async"
          />
          <figcaption>{screenshot[lang].caption}</figcaption>
        </figure>
      </section>
    )}
    {!content.limitations && (
      <section class="case-study__pending" aria-labelledby="case-study-pending">
        <h2 id="case-study-pending">{copy.scopeTitle}</h2>
        <p>{content.openItems}</p>
      </section>
    )}
    {project.repositoryUrl && (
      <p class="case-study__repository">
        <span>{copy.repository}</span>
        <a
          href={project.repositoryUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {project.repositoryLabel}
        </a>
      </p>
    )}
    <a class="case-study__back" href={isFrench ? "/fr/projets/" : "/projects/"}>
      {copy.back}
    </a>
  </article>
</PageFrame>
