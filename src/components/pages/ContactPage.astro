---
import PageFrame from "./PageFrame.astro";

/** @typedef {{ lang: "en" | "fr" }} Props */
/** @type {Props} */
const { lang } = Astro.props;
const copy =
  lang === "fr"
    ? {
        label: "Contact",
        title: "Contacter Ernest",
        introduction:
          "Choisissez le canal public qui vous convient pour prendre contact.",
        heading: "Canaux de contact",
        whatsapp: "WhatsApp",
        phone: "+237 673 063 503",
        email: "E-mail",
        emailAddress: "joreswabo01@gmail.com",
        facebook: "Facebook",
        linkedin: "LinkedIn",
        github: "GitHub",
      }
    : {
        label: "Contact",
        title: "Contact Ernest",
        introduction:
          "Choose the public channel that works best for getting in touch.",
        heading: "Contact channels",
        whatsapp: "WhatsApp",
        phone: "+237 673 063 503",
        email: "Email",
        emailAddress: "joreswabo01@gmail.com",
        facebook: "Facebook",
        linkedin: "LinkedIn",
        github: "GitHub",
      };
---

<PageFrame
  lang={lang}
  label={copy.label}
  title={copy.title}
  introduction={copy.introduction}
>
  <section class="contact-channels" aria-labelledby="contact-channels-title">
    <h2 id="contact-channels-title">{copy.heading}</h2>
    <ul class="contact-channel-list">
      <li>
        <h3>{copy.whatsapp}</h3>
        <a href="https://wa.me/237673063503">{copy.phone}</a>
      </li>
      <li>
        <h3>{copy.email}</h3>
        <a href="mailto:joreswabo01@gmail.com">{copy.emailAddress}</a>
      </li>
      <li>
        <h3>{copy.facebook}</h3>
        <a href="https://www.facebook.com/share/1CMw7XtvfF/">{copy.facebook}</a>
      </li>
      <li>
        <h3>{copy.linkedin}</h3>
        <a href="https://www.linkedin.com/in/jores-wabo-9b8938427/">
          {copy.linkedin}
        </a>
      </li>
      <li>
        <h3>{copy.github}</h3>
        <a href="https://github.com/ProgErnest/">{copy.github}</a>
      </li>
    </ul>
  </section>
</PageFrame>
