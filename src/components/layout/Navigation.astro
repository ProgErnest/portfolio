---
import ThemeToggle from "../ui/ThemeToggle.astro";

/** @typedef {{ lang?: "en" | "fr", currentPath?: string }} Props */
/** @type {Props} */
const { lang = "en", currentPath = "/" } = Astro.props;
const isFrench = lang === "fr";

const copy = isFrench
  ? {
      brand: "Ernest Programmer, accueil",
      navigation: "Navigation principale",
      menu: "Menu",
      openMenu: "Menu, ouvrir la navigation",
      closeMenu: "Menu, fermer la navigation",
      home: "Accueil",
      about: "À propos",
      projects: "Projets",
      skills: "Compétences",
      experience: "Expérience",
      contact: "Contact",
      planned: "Prévu",
      unavailable:
        "La version française de cette page n’est pas encore disponible.",
      switchToEnglish: "Passer à l’anglais",
    }
  : {
      brand: "Ernest Programmer, home",
      navigation: "Primary navigation",
      menu: "Menu",
      openMenu: "Menu, open navigation",
      closeMenu: "Menu, close navigation",
      home: "Home",
      about: "About",
      projects: "Projects",
      skills: "Skills",
      experience: "Experience",
      contact: "Contact",
      planned: "Planned",
      unavailable: "The French version of this page is not available yet.",
      switchToFrench: "Switch to French",
    };

const languagePath =
  currentPath === "/design-system/"
    ? "/fr/design-system/"
    : currentPath === "/fr/design-system/"
      ? "/design-system/"
      : null;
const languageCode = isFrench ? "en" : "fr";
const languageLabel = isFrench ? copy.switchToEnglish : copy.switchToFrench;
const items = [
  { label: copy.home, href: "/", current: currentPath === "/" },
  { label: copy.about },
  { label: copy.projects },
  { label: copy.skills },
  { label: copy.experience },
  { label: copy.contact },
];
---

<header class="site-header">
  <a class="site-brand" href="/" aria-label={copy.brand}>
    <span class="site-brand__mark" aria-hidden="true">
      EP
    </span>
    <span class="site-brand__name">Ernest Programmer</span>
  </a>

  <details
    class="primary-navigation"
    data-site-navigation
    data-open-label={copy.openMenu}
    data-close-label={copy.closeMenu}
    open
  >
    <summary class="primary-navigation__toggle" aria-controls="primary-menu">
      <svg
        class="primary-navigation__icon"
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
      >
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <span>{copy.menu}</span>
    </summary>
    <nav
      class="primary-navigation__panel"
      id="primary-menu"
      aria-label={copy.navigation}
    >
      <ul class="primary-navigation__list">
        {items.map((item) => (
          <li>
            {item.href ? (
              <a
                class="primary-navigation__link"
                href={item.href}
                aria-current={item.current ? "page" : undefined}
              >
                {item.label}
              </a>
            ) : (
              <span class="primary-navigation__unavailable">
                <span>{item.label}</span>
                <small>{copy.planned}</small>
              </span>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </details>

  <div class="site-header__tools">
    {languagePath ? (
      <a
        class="language-switch"
        href={languagePath}
        lang={languageCode}
        aria-label={languageLabel}
        title={languageLabel}
      >
        <span aria-hidden="true">{languageCode.toUpperCase()}</span>
      </a>
    ) : (
      <button
        class="language-switch language-switch--unavailable"
        type="button"
        disabled
        aria-label={copy.unavailable}
        title={copy.unavailable}
      >
        <span aria-hidden="true">{languageCode.toUpperCase()}</span>
      </button>
    )}
    <ThemeToggle lang={lang} />
  </div>
</header>

<script>
  const menu = document.querySelector("[data-site-navigation]");

  if (!(menu instanceof HTMLDetailsElement)) {
    throw new Error("The primary navigation disclosure is missing.");
  }

  const summary = menu.querySelector("summary");
  const mobileViewport = window.matchMedia("(max-width: 760px)");

  if (!(summary instanceof HTMLElement)) {
    throw new Error("The primary navigation summary is missing.");
  }

  const updateMenuLabel = () => {
    summary.setAttribute(
      "aria-label",
      menu.open
        ? (menu.dataset.closeLabel ?? "Menu, close navigation")
        : (menu.dataset.openLabel ?? "Menu, open navigation"),
    );
  };

  if (mobileViewport.matches) {
    menu.open = false;
  }
  updateMenuLabel();

  menu.addEventListener("toggle", updateMenuLabel);
  mobileViewport.addEventListener("change", (event) => {
    menu.open = !event.matches;
    updateMenuLabel();
  });

  menu.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && mobileViewport.matches && menu.open) {
      event.preventDefault();
      menu.open = false;
      summary.focus();
    }
  });

  menu.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      if (mobileViewport.matches) {
        menu.open = false;
      }
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0.75rem;
    display: flex;
    width: min(100% - 2rem, 76rem);
    min-height: 4.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    margin: 0.75rem auto 0;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border-default);
    border-radius: 0.85rem;
    background: color-mix(in srgb, var(--surface-card) 92%, transparent);
    color: var(--text-primary);
    backdrop-filter: blur(1rem);
  }

  .site-brand {
    display: inline-flex;
    min-width: max-content;
    align-items: center;
    gap: 0.65rem;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 650;
    text-decoration: none;
  }

  .site-brand__mark {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 1px solid var(--border-default);
    border-radius: 0.55rem;
    background: var(--surface-raised);
    color: var(--accent-green);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.07em;
  }

  .primary-navigation {
    flex: 1;
  }

  .primary-navigation__toggle {
    display: none;
  }

  .primary-navigation__list {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .primary-navigation__link,
  .primary-navigation__unavailable {
    display: inline-flex;
    min-height: 2.65rem;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.6rem;
    border-radius: 0.5rem;
    color: var(--text-primary);
    font-size: 0.875rem;
    font-weight: 550;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
  }

  .primary-navigation__link:hover,
  .primary-navigation__link[aria-current="page"] {
    background: var(--surface-raised);
    color: var(--accent-green);
  }

  .primary-navigation__link[aria-current="page"] {
    font-weight: 700;
  }

  .primary-navigation__unavailable {
    color: var(--text-muted);
  }

  .primary-navigation__unavailable small {
    color: var(--text-muted);
    font-size: 0.65rem;
    font-weight: 500;
  }

  .site-header__tools {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.5rem;
  }

  .language-switch {
    display: inline-grid;
    min-width: 2.75rem;
    min-height: 2.75rem;
    place-items: center;
    padding: 0.45rem;
    border: 1px solid var(--border-default);
    border-radius: 0.6rem;
    background: var(--surface-card);
    color: var(--text-primary);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
  }

  .language-switch:hover:not(:disabled) {
    border-color: var(--accent-blue);
    color: var(--accent-blue);
  }

  .language-switch:disabled {
    cursor: not-allowed;
    opacity: 0.65;
  }

  @media (max-width: 760px) {
    .site-header {
      gap: 0.6rem;
    }

    .primary-navigation {
      position: static;
      flex: none;
      order: 1;
    }

    .primary-navigation__toggle {
      display: inline-flex;
      min-height: 2.75rem;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      padding: 0.5rem 0.65rem;
      border: 1px solid var(--border-default);
      border-radius: 0.6rem;
      background: var(--surface-card);
      color: var(--text-primary);
      font-size: 0.875rem;
      font-weight: 600;
      line-height: 1;
      cursor: pointer;
      list-style: none;
    }

    .primary-navigation__toggle::-webkit-details-marker {
      display: none;
    }

    .primary-navigation__icon {
      width: 1.15rem;
      height: 1.15rem;
      flex: none;
    }

    .primary-navigation__panel {
      position: absolute;
      top: calc(100% + 0.5rem);
      right: 0;
      left: 0;
      padding: 0.65rem;
      border: 1px solid var(--border-default);
      border-radius: 0.75rem;
      background: var(--surface-card);
      box-shadow: 0 0.75rem 2rem
        color-mix(in srgb, var(--text-primary) 12%, transparent);
    }

    .primary-navigation__list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.25rem;
    }

    .primary-navigation__link,
    .primary-navigation__unavailable {
      width: 100%;
      justify-content: space-between;
      padding-inline: 0.7rem;
    }

    .site-header__tools {
      order: 2;
    }
  }

  @media (max-width: 380px) {
    .site-header {
      width: calc(100% - 1rem);
      padding-inline: 0.5rem;
    }

    .site-brand__name {
      display: none;
    }
  }
</style>
