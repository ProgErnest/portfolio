      copied: "Texte du spécimen copié.",
      copyMessage:
        "Exemple d’action; aucune coordonnée personnelle n’est incluse.",
      pattern: "Motif",
      motionSequence: "Construction en trois temps",
      motionSequenceHint:
        "Les effets de mouvement servent l’ordre de lecture; ils ne conditionnent jamais l’accès au contenu.",
      stepOne: "Identité",
      stepTwo: "Système",
      stepThree: "Preuve",
      transition: "Transition de route",
      transitionHint:
        "Le masque vertical est une direction retenue. Il ne sera activé qu’après le prototype de navigation P3.",
      maskPrototype: "Tester le masque vertical",
      maskStatusIdle: "Prototype isolé, aucune navigation déclenchée.",
      maskStatusCover: "Masque ouvert.",
      maskStatusReveal: "Masque fermé; état final restauré.",
      reduced: "Mouvement réduit",
      reducedHint:
        "Le système respecte prefers-reduced-motion : états finaux immédiats, aucune scène non essentielle.",
