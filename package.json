{
  "name": "ernest-programmer-portfolio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint \"src/**/*.{js,ts,astro}\"",
    "format": "prettier --write \"src/**/*.{js,ts,astro,css}\" \"*.{json,mjs}\" \".vscode/*.json\" \"eslint.config.mjs\" \".prettierrc.mjs\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,astro,css}\" \"*.{json,mjs}\" \".vscode/*.json\" \"eslint.config.mjs\" \".prettierrc.mjs\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^1.2.2",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3"
  }
}
